# Скопируй этот файл в .env и впиши ключи ТЕХ провайдеров, которыми пользуешься.
# Для бесплатного Ollama ключи НЕ нужны — этот файл можно вообще не трогать.

# Claude (Anthropic):   https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# GPT (OpenAI):          https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Gemini (Google):       https://aistudio.google.com/apikey
# 🆓 На момент записи курса у Google есть БЕСПЛАТНЫЙ доступ к Gemini по API
#    (бесплатный лимит; условия со временем могут меняться). Ключ — по ссылке выше.
GOOGLE_API_KEY=...

# DeepSeek (дёшево):     https://platform.deepseek.com  → API Keys
DEEPSEEK_API_KEY=...

# Mistral (Европа, есть free-лимит):  https://console.mistral.ai/api-keys
MISTRAL_API_KEY=...

# 🇷🇺 YandexGPT — оплата в рублях, без зарубежной карты.
#    Ключ и folder_id (ID каталога): https://console.cloud.yandex.ru → сервис «AI Studio / Foundation Models»
YANDEX_API_KEY=...
YANDEX_FOLDER_ID=...

# 🇷🇺 GigaChat (Сбер) — тоже в рублях, но подключается ПО СВОЕЙ схеме (OAuth-токен,
#    пакет gigachat), не через этот файл напрямую. Как подключить — см. LANDSCAPE.md.
# GIGACHAT_CREDENTIALS=...

# 🗄️ База данных для «долгой памяти» бота (записи клиентов).
#    НЕ обязательно: если строки нет — бот пишет записи в файл leads.json (локально).
#    Есть строка → бот пишет в базу (переживает перезапуск). Как получить — см. DEPLOY.md, Шаг 2.
#    Supabase: Settings → Database → Connection string → URI.
# DATABASE_URL=postgresql://postgres:ПАРОЛЬ@db.xxxx.supabase.co:5432/postgres
